# --- Network / vault -------------------------------------------------------
NEAR_NETWORK=testnet                 # testnet | mainnet (1Click itself is mainnet-only)
AGENT_ID=payroll                     # agent slot created by the owner (add_agent); this worker registers into it
VAULT_CONTRACT_ID=                   # the vault contract account (it is also the Shade agent contract, docs/adr/0001)
NEAR_RPC_URL=                        # optional; default fastnear for the selected network

# --- Agent account funding / local key derivation ---------------------------
# Generate with: pnpm exec shade auth set near testnet create-new   (see README)
SPONSOR_ACCOUNT_ID=
SPONSOR_PRIVATE_KEY=                 # NEVER commit. In local mode the agent key is derived from it.

# --- Run mode ---------------------------------------------------------------
RUN_MODE=local                       # local = INSECURE dev mode (no TEE) | tee = Phala via shade-agent-cli
ALLOW_INSECURE_LOCAL_MODE=false         # must be "true" to run RUN_MODE=local on mainnet (red warning at start)
DRY_RUN=true                         # true: only dry quotes, never request_payout. Set false deliberately.
LOOP_INTERVAL_MIN=15
STATUS_POLL_TIMEOUT_MIN=20

# --- 1Click -----------------------------------------------------------------
ONECLICK_BASE_URL=https://1click.chaindefuser.com
ONECLICK_API_KEY=                    # optional (X-API-Key); without it a 0.2% fee applies
ONECLICK_MODE=live                   # live | simulated. simulated = offline fake 1Click for TESTNET reproduction only (refused on mainnet)
SIMULATED_OUTCOME=success            # success | refunded (only used when ONECLICK_MODE=simulated)

# --- HTTP API ---------------------------------------------------------------
PORT=3000
# Bind address (default localhost). Docker sets 0.0.0.0.
# HOST=127.0.0.1
WORKER_ADMIN_TOKEN=                  # enables POST /run (Authorization: Bearer <token>); unset = disabled
DASHBOARD_ORIGIN=http://localhost:5173
HTTP_TIMEOUT_MS=15000

# --- AI assistant (UI_UPDATES.md section 6; NEAR AI Cloud, OpenAI-compatible) -----------------------
NEARAI_API_KEY=                      # NEVER commit. From https://cloud.near.ai. Unset = /ai/chat answers with an error event
NEARAI_MODEL=z-ai/glm-5.3-flash      # a NEAR-run confidential-TEE model with tool calling (check GET /v1/models: owned_by=nearai)
NEARAI_BASE_URL=https://cloud-api.near.ai/v1
AI_SESSION_SECRET=                   # >= 32 random chars (openssl rand -hex 32). NEVER commit. Unset = /ai routes are not mounted
AI_RATE_LIMIT_PER_MIN=10             # per client IP
AI_MAX_MESSAGES=30
AI_MAX_MESSAGE_CHARS=4000
AI_TIMEOUT_MS=90000
AI_TRUST_PROXY=false                 # true only behind a proxy you control (uses X-Forwarded-For)

# --- Hyperliquid spot trading (docs/adr/0005). Everything below is inert while TRADING_ENABLED=false ----------------
# Needs AI_SESSION_SECRET (owner sessions) and RUN_MODE=local. The bot trades SPOT only. The HL API wallet cannot withdraw to another address, but it CAN trade perps (incl. HIP-3 dexes the bot does not watch) and move funds spot<->perp: keep only session funds on the HL master, valid_until <= 48 h, revoke after use.
TRADING_ENABLED=false                # true mounts /trading and starts the engine
HL_NETWORK=testnet                   # mainnet ALSO requires TRADING_ALLOW_MAINNET=true
TRADING_ALLOW_MAINNET=false          # explicit opt-in: real money
HL_MASTER_ADDRESS=                   # the owner's DEDICATED Hyperliquid account (0x + 40 hex); must be the single `hypercore` allowlist entry of the hl-trader mandate
HL_API_WALLET_PRIVATE_KEY=           # tests only. Unset = the bot generates a key into TRADING_STATE_DIR/api-wallet.json (mode 0600)
TRADING_STATE_DIR=./.trading         # rules, engine state, log.jsonl, API wallet (gitignored)
TRADER_AGENT_ID=hl-trader            # vault agent slot of the trader (a Key agent, ADR-0005 section 1)
TRADER_NEAR_ACCOUNT_ID=              # e.g. hl-trader.<owner>.testnet (created by sdk/scripts/setup-key-agent.ts)
TRADER_NEAR_PRIVATE_KEY=             # ed25519:... function-call key of that account (secret, NEVER commit). Required while TRADING_TOPUP_ENABLED=true
TRADING_TICK_SEC=60                  # 15..600
TRADING_ALLOWED_PAIRS=HYPE/USDC      # hard pair allowlist, comma-separated, 1..3 entries
TRADING_MIN_PAIR_VOLUME_USDC=1000000 # minimum 24 h notional volume of a pair
TRADING_HARD_MAX_POSITION_USDC=50    # hard caps: a rule set above them is rejected, never clamped
TRADING_HARD_MAX_ORDER_USDC=20       # >= 10 (Hyperliquid minimum order value)
TRADING_HARD_DAILY_LOSS_USDC=10
TRADING_HARD_MAX_ORDERS_PER_DAY=20   # 1..50
TRADING_PRICE_BAND_BPS=100           # orders are priced within +-band of the mid, 10..200
TRADING_DEADMAN_SEC=180              # scheduleCancel horizon, >= 3 x TRADING_TICK_SEC
TRADING_TOPUP_ENABLED=true           # allow request_payment top-ups from the vault to the HL account
TRADING_TOPUP_USDC=20                # size of each top-up (>= 2, the 1Click minimum)
TRADING_TOPUP_FLOOR_USDC=10          # top up when free HL USDC is below this
TRADING_START_MS=                    # baseline for net_funded; unset = first tick of this state dir
