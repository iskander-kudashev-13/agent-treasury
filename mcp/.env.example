# agent-treasury-mcp configuration (no secrets here; put real values in the MCP client's env block or a local .env you never commit)
TREASURY_VAULT=vault.example.near
TREASURY_NETWORK=mainnet            # mainnet | testnet
TREASURY_AGENT_ACCOUNT=procurement.example.near
TREASURY_AGENT_PRIVATE_KEY=         # ed25519:... the function-call key printed once by setup-key-agent; empty = read-only tools only
# TREASURY_AGENT_ID=procurement     # optional, skips the agent lookup
# NEAR_RPC=                         # optional, default https://free.rpc.fastnear.com (testnet: https://test.rpc.fastnear.com)
ONECLICK_BASE_URL=https://1click.chaindefuser.com
ONECLICK_JWT=                       # optional 1Click partner JWT (without it 1Click charges a small extra fee)
ONECLICK_MODE=live                  # live | simulated (simulated: testnet only, fakes 1Click, nothing leaves NEAR)
