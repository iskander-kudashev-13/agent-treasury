# Agent Treasury — root environment template. Copy to .env (gitignored) and fill in. Never commit real values.
# Component-specific templates: worker/.env.example, dashboard/.env.example, mcp/.env.example, sdk/.env.example.

# --- NEAR ---
NEAR_NETWORK=testnet                     # testnet for the vault; mainnet only for the final demo (human go-ahead)
VAULT_CONTRACT_ID=                       # e.g. agent-treasury.<you>.testnet
OWNER_ACCOUNT_ID=                        # the treasury owner (full-access key stays in your wallet / near-cli keychain)
TREASURY_TOKEN_ID=                       # USDC NEP-141. mainnet: 17208628f84f5d6ad33f0da3bbbeb27ffcb398eac501a31bd6ad2011e36133a1

# --- Shade Agent worker ---
SPONSOR_ACCOUNT_ID=                      # pays the agent's gas/registration
SPONSOR_PRIVATE_KEY=                     # ed25519:... (secret)
RUN_MODE=local                           # local (no TEE, dev only) | tee (Phala)
PHALA_API_KEY=                           # cloud.phala.network/dashboard/tokens (secret, tee mode only)

# --- NEAR Intents 1Click ---
ONECLICK_BASE_URL=https://1click.chaindefuser.com
ONECLICK_API_KEY=                        # optional, partners.near-intents.org (without it ~0.2% fee)

# --- NEAR AI Cloud (optional, M6) ---
NEARAI_API_KEY=                          # cloud.near.ai (secret)
