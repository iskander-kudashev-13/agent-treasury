{
  "name": "agent-treasury-sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for AI agents that pay from an Agent Treasury vault under an on-chain mandate",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "setup-key-agent": "tsx scripts/setup-key-agent.ts",
    "revoke-key-agent": "tsx scripts/revoke-key-agent.ts"
  },
  "packageManager": "pnpm@11.22.0",
  "dependencies": {
    "near-api-js": "7.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "20.19.39",
    "eslint": "10.14.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
