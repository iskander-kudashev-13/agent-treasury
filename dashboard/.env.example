# Public config (bundled into the browser by Vite). No secrets here.
# `testnet` | `mainnet`
VITE_NEAR_NETWORK=testnet
# Optional RPC override (default: https://test.rpc.fastnear.com / https://free.rpc.fastnear.com)
VITE_NEAR_RPC=
# Deployed vault contract account (required)
VITE_VAULT_CONTRACT=
# USDC NEP-141 contract for the network (deposit modal, owner balance). Optional until the Deposit flow is built.
VITE_USDC_CONTRACT=
# Worker HTTP API (GET /status, GET /runs, POST /ai/chat). Optional; the agent card shows "offline" if unset.
VITE_WORKER_URL=http://localhost:3001
# Show the AI assistant (needs the worker /ai endpoints). true | false
VITE_AI_ENABLED=false
# NEAR Intents 1Click API base (GET /v0/status "Quote check" before approving a payout). Default shown.
VITE_ONECLICK_BASE_URL=https://1click.chaindefuser.com
# Legacy names still read as a fallback: VITE_VAULT_CONTRACT_ID, VITE_NEAR_RPC_URL
